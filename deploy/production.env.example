OA_IMAGE_TAG=local
OA_PUBLIC_ORIGIN=https://oa.example.com
OA_PUBLIC_HOST=oa.example.com
OA_HTTP_PORT=8080
OA_HTTPS_PORT=8443
OA_CLAMAV_IMAGE=clamav/clamav:1.4
OA_CLAMAV_PLATFORM=linux/amd64
OA_CLAMAV_MEMORY_LIMIT=4g
OA_SIGNING_KEY_FILE=./deploy/secrets/Authentication__SigningKey
OA_DATABASE_CONNECTION_FILE=./deploy/secrets/ConnectionStrings__OaDatabase
OA_MFA_ENCRYPTION_KEY_FILE=./deploy/secrets/Authentication__MultiFactor__EncryptionKey
OA_BOOTSTRAP_ENABLED=true
OA_BOOTSTRAP_ADMIN_USER_ID=oa-admin
OA_BOOTSTRAP_ADMIN_NAME=系统管理员
OA_BOOTSTRAP_DEPARTMENT_ID=management
OA_BOOTSTRAP_DEPARTMENT_NAME=管理部
OA_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=ADMIN-001
OA_BOOTSTRAP_ADMIN_HIRE_DATE=2026-01-01
OA_BOOTSTRAP_ADMIN_PASSWORD_FILE=./deploy/secrets/Bootstrap__AdminPassword
OA_PERSONNEL_HR_ASSIGNEE_ID=replace-with-active-hr-user-id
OA_PERSONNEL_FINANCE_ASSIGNEE_ID=replace-with-active-finance-user-id
OA_PERSONNEL_IT_ASSIGNEE_ID=replace-with-active-it-user-id
OA_PERSONNEL_ADMIN_ASSIGNEE_ID=replace-with-active-admin-user-id
OA_PERSONNEL_ALERT_INTERVAL_MINUTES=60
OA_PERSONNEL_ALERT_DUE_SOON_DAYS=1
OA_PERSONNEL_ALERT_ESCALATE_DAYS=3
OA_PERSONNEL_EXPORT_MAX_ROWS=10000
OA_PASSWORD_CHANGE_CHALLENGE_MINUTES=10
OA_TLS_CERTIFICATE_FILE=./deploy/tls/tls.crt
OA_TLS_PRIVATE_KEY_FILE=./deploy/tls/tls.key
