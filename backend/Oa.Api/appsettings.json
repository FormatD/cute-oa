{
  "Persistence": {
    "UsePostgreSql": true
  },
  "DemoFeatures": {
    "AllowDataGeneration": false
  },
  "ContractAlerts": {
    "Enabled": true,
    "IntervalMinutes": 360
  },
  "Authentication": {
    "Issuer": "cute-oa",
    "Audience": "cute-oa-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "Root": "storage/files"
  },
  "AllowedHosts": "*"
}
